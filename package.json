{
  "name": "@aqsh/note-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Aqsh note editorial source repository and safe Playwright draft CLI",
  "type": "module",
  "bin": {
    "aqsh-note": "./bin/aqsh-note.mjs"
  },
  "scripts": {
    "aqsh-note": "node ./bin/aqsh-note.mjs",
    "test": "node --test --test-reporter=spec tests/unit/*.test.mjs",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.mjs",
    "test:e2e": "playwright test tests/e2e",
    "check": "npm run test:unit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
